<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_height="wrap_content" android:text="APPEL" android:textColor="#AAB3D2" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_width="0dp" android:layout_weight="1"/><ImageView android:id="@+id/refresh" android:layout_width="26dp" android:layout_height="26dp" android:padding="4dp" android:src="@drawable/ic_refresh" android:contentDescription="Actualiser" /></LinearLayout><TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#AAB3D2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" /><TextView android:id="@+id/appel_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1"/><TextView android:id="@+id/appel_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/><TextView android:id="@+id/appel_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Faire l\'appel" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/btn_accent" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/upd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#AAB3D2" android:textSize="9sp" android:maxLines="1"/>
</LinearLayout>
